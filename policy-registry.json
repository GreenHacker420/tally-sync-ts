{
  "version": 1,
  "defs": [
    {
      "key": "gate.timeoutMs",
      "kind": "int",
      "default": 30000,
      "unit": "ms",
      "min": 1000,
      "max": 600000,
      "description": "Hard ceiling for one Tally request; Tally keeps working after a client timeout, so this only bounds our wait."
    },
    {
      "key": "gate.cooldownMs",
      "kind": "int",
      "default": 15000,
      "unit": "ms",
      "min": 1000,
      "max": 3600000,
      "description": "How long the circuit stays open before a light probe is tried."
    },
    {
      "key": "gate.failureThreshold",
      "kind": "int",
      "default": 2,
      "unit": "failures",
      "min": 1,
      "max": 20,
      "description": "Consecutive connection failures before the circuit opens."
    },
    {
      "key": "gate.probeTimeoutMs",
      "kind": "int",
      "default": 10000,
      "unit": "ms",
      "min": 500,
      "max": 120000,
      "description": "Timeout of the light probe sent in half-open state."
    },
    {
      "key": "recording.capacity",
      "kind": "int",
      "default": 50,
      "unit": "exchanges",
      "min": 1,
      "max": 1000,
      "description": "Size of the redacted flight-recorder ring buffer."
    },
    {
      "key": "recording.maxChars",
      "kind": "int",
      "default": 4000,
      "unit": "chars",
      "min": 200,
      "max": 200000,
      "description": "Characters kept per recorded request/response."
    },
    {
      "key": "discovery.maxDepth",
      "kind": "int",
      "default": 4,
      "unit": "levels",
      "min": 1,
      "max": 10,
      "description": "Directory depth of the data-folder drive scan."
    },
    {
      "key": "discovery.maxDirs",
      "kind": "int",
      "default": 20000,
      "unit": "directories",
      "min": 100,
      "max": 1000000,
      "description": "Directory budget of the drive scan."
    },
    {
      "key": "discovery.timeBudgetMs",
      "kind": "int",
      "default": 20000,
      "unit": "ms",
      "min": 1000,
      "max": 600000,
      "description": "Time budget of the drive scan."
    },
    {
      "key": "sync.windowTargetMs",
      "kind": "int",
      "default": 2000,
      "unit": "ms",
      "min": 200,
      "max": 30000,
      "description": "Target duration of one Tally read window; sizes the date window."
    },
    {
      "key": "sync.msPerVoucherEstimate",
      "kind": "int",
      "default": 7,
      "unit": "ms",
      "min": 1,
      "max": 1000,
      "description": "Cost model used until real latency is measured (conservative; measured 3-7 ms per voucher)."
    },
    {
      "key": "adaptive.timeoutFactor",
      "kind": "int",
      "default": 3,
      "unit": "x p95",
      "min": 1,
      "max": 20,
      "description": "Request timeout as a multiple of the measured p95 latency, once enough samples exist."
    },
    {
      "key": "adaptive.minSamples",
      "kind": "int",
      "default": 20,
      "unit": "samples",
      "min": 5,
      "max": 10000,
      "description": "Latency samples needed before measured values replace the defaults."
    },
    {
      "key": "adaptive.timeoutFloorMs",
      "kind": "int",
      "default": 2000,
      "unit": "ms",
      "min": 200,
      "max": 60000,
      "description": "Lowest timeout the adaptive control may choose, whatever the latency."
    },
    {
      "key": "batch.start",
      "kind": "int",
      "default": 10,
      "unit": "vouchers",
      "min": 1,
      "max": 1000,
      "description": "Initial vouchers per import batch."
    },
    {
      "key": "batch.min",
      "kind": "int",
      "default": 1,
      "unit": "vouchers",
      "min": 1,
      "max": 1000,
      "description": "Smallest import batch the adaptive control may fall back to."
    },
    {
      "key": "batch.max",
      "kind": "int",
      "default": 200,
      "unit": "vouchers",
      "min": 1,
      "max": 5000,
      "description": "Largest import batch the adaptive control may grow to."
    },
    {
      "key": "batch.growBy",
      "kind": "int",
      "default": 5,
      "unit": "vouchers",
      "min": 1,
      "max": 500,
      "description": "Vouchers added to the batch after each fast, successful import (additive increase)."
    },
    {
      "key": "batch.shrinkPercent",
      "kind": "int",
      "default": 50,
      "unit": "%",
      "min": 10,
      "max": 90,
      "description": "Percentage of the batch kept after a slow or failed import (multiplicative decrease)."
    },
    {
      "key": "retry.transientScheduleSec",
      "kind": "string",
      "default": "5,15,45,120,300,900",
      "unit": "seconds",
      "description": "Comma-separated delays between attempts for transient failures; the last one repeats."
    },
    {
      "key": "retry.jitterPercent",
      "kind": "int",
      "default": 20,
      "unit": "%",
      "min": 0,
      "max": 100,
      "description": "Random spread applied to retry delays so many agents do not retry in step."
    },
    {
      "key": "learn.sampleVouchers",
      "kind": "int",
      "default": 200,
      "unit": "vouchers",
      "min": 20,
      "max": 2000,
      "description": "Recent vouchers of a type read to learn how the company writes them."
    },
    {
      "key": "learn.maxMonths",
      "kind": "int",
      "default": 12,
      "unit": "months",
      "min": 1,
      "max": 60,
      "description": "How far back the learner looks for its sample."
    },
    {
      "key": "learn.minConfidencePercent",
      "kind": "int",
      "default": 90,
      "unit": "%",
      "min": 50,
      "max": 100,
      "description": "Share of sampled vouchers that must agree before a learned value is used without asking the owner."
    },
    {
      "key": "learn.refreshHours",
      "kind": "int",
      "default": 24,
      "unit": "hours",
      "min": 1,
      "max": 720,
      "description": "Age after which a learned company context is re-learned even if the masters did not change."
    },
    {
      "key": "retry.maxAttempts",
      "kind": "int",
      "default": 8,
      "unit": "attempts",
      "min": 1,
      "max": 50,
      "description": "Attempts a job gets before it is moved to the dead-letter state for a person to look at."
    },
    {
      "key": "queue.maxPending",
      "kind": "int",
      "default": 5000,
      "unit": "jobs",
      "min": 100,
      "max": 1000000,
      "description": "Pending jobs the local queue accepts before it sheds background work and refuses new events (financial jobs are never dropped)."
    },
    {
      "key": "queue.retentionDays",
      "kind": "int",
      "default": 30,
      "unit": "days",
      "min": 1,
      "max": 365,
      "description": "How long finished jobs are kept before pruning, so the local database stays bounded."
    },
    {
      "key": "queue.leaseSeconds",
      "kind": "int",
      "default": 300,
      "unit": "seconds",
      "min": 30,
      "max": 3600,
      "description": "How long a worker may hold a job; after that another worker may take it and the stale worker's result is ignored."
    },
    {
      "key": "cloud.requestTimeoutMs",
      "kind": "int",
      "default": 30000,
      "unit": "ms",
      "min": 1000,
      "max": 300000,
      "description": "Total deadline of one cloud request."
    },
    {
      "key": "cloud.maxResponseBytes",
      "kind": "int",
      "default": 5000000,
      "unit": "bytes",
      "min": 100000,
      "max": 100000000,
      "description": "Largest cloud response the agent will buffer."
    },
    {
      "key": "cloud.breakerFailureThreshold",
      "kind": "int",
      "default": 5,
      "unit": "failures",
      "min": 1,
      "max": 100,
      "description": "Availability failures within the window that open the cloud circuit."
    },
    {
      "key": "cloud.breakerWindowMs",
      "kind": "int",
      "default": 60000,
      "unit": "ms",
      "min": 5000,
      "max": 3600000,
      "description": "Rolling window in which cloud failures are counted."
    },
    {
      "key": "cloud.breakerCooldownMs",
      "kind": "int",
      "default": 30000,
      "unit": "ms",
      "min": 1000,
      "max": 3600000,
      "description": "How long the cloud circuit stays open before one probe is allowed."
    },
    {
      "key": "sse.idleTimeoutMs",
      "kind": "int",
      "default": 60000,
      "unit": "ms",
      "min": 10000,
      "max": 600000,
      "description": "Silence on the event stream (it sends keepalives) after which the connection is treated as dead and re-opened."
    },
    {
      "key": "sse.maxBufferBytes",
      "kind": "int",
      "default": 1000000,
      "unit": "bytes",
      "min": 10000,
      "max": 50000000,
      "description": "Largest incomplete event line buffered from the event stream."
    },
    {
      "key": "reconnect.baseMs",
      "kind": "int",
      "default": 2000,
      "unit": "ms",
      "min": 100,
      "max": 60000,
      "description": "First reconnect delay; doubles per failure with jitter."
    },
    {
      "key": "reconnect.maxMs",
      "kind": "int",
      "default": 300000,
      "unit": "ms",
      "min": 1000,
      "max": 3600000,
      "description": "Longest reconnect delay."
    },
    {
      "key": "sync.pullIntervalSec",
      "kind": "int",
      "default": 120,
      "unit": "seconds",
      "min": 15,
      "max": 3600,
      "description": "Backstop interval for pulling cloud events even when no wake-up arrives."
    },
    {
      "key": "sync.alterIdPageSize",
      "kind": "int",
      "default": 500,
      "unit": "AlterIDs",
      "min": 50,
      "max": 5000,
      "description": "Width of one AlterID range read from Tally, so one request never loads a whole company."
    },
    {
      "key": "sync.uploadChunkVouchers",
      "kind": "int",
      "default": 500,
      "unit": "vouchers",
      "min": 50,
      "max": 5000,
      "description": "Vouchers per upload to the cloud."
    },
    {
      "key": "resource.maxHeapMb",
      "kind": "int",
      "default": 768,
      "unit": "MB",
      "min": 128,
      "max": 8192,
      "description": "Heap size above which background extraction is paused (posting continues)."
    },
    {
      "key": "resource.minFreeDiskMb",
      "kind": "int",
      "default": 500,
      "unit": "MB",
      "min": 50,
      "max": 100000,
      "description": "Free disk space below which background extraction and non-essential writes stop."
    },
    {
      "key": "resource.maxEventLoopDelayMs",
      "kind": "int",
      "default": 500,
      "unit": "ms",
      "min": 50,
      "max": 10000,
      "description": "Event-loop delay (p99) above which background work is shed."
    }
  ]
}
