{
  "version": 1,
  "defs": [
    {
      "key": "gate.timeoutMs",
      "kind": "int",
      "default": 30000,
      "unit": "ms",
      "min": 1000,
      "max": 600000,
      "description": "Hard ceiling for one Tally request; Tally keeps working after a client timeout, so this only bounds our wait."
    },
    {
      "key": "gate.cooldownMs",
      "kind": "int",
      "default": 15000,
      "unit": "ms",
      "min": 1000,
      "max": 3600000,
      "description": "How long the circuit stays open before a light probe is tried."
    },
    {
      "key": "gate.failureThreshold",
      "kind": "int",
      "default": 2,
      "unit": "failures",
      "min": 1,
      "max": 20,
      "description": "Consecutive connection failures before the circuit opens."
    },
    {
      "key": "gate.probeTimeoutMs",
      "kind": "int",
      "default": 10000,
      "unit": "ms",
      "min": 500,
      "max": 120000,
      "description": "Timeout of the light probe sent in half-open state."
    },
    {
      "key": "recording.capacity",
      "kind": "int",
      "default": 50,
      "unit": "exchanges",
      "min": 1,
      "max": 1000,
      "description": "Size of the redacted flight-recorder ring buffer."
    },
    {
      "key": "recording.maxChars",
      "kind": "int",
      "default": 4000,
      "unit": "chars",
      "min": 200,
      "max": 200000,
      "description": "Characters kept per recorded request/response."
    },
    {
      "key": "discovery.maxDepth",
      "kind": "int",
      "default": 4,
      "unit": "levels",
      "min": 1,
      "max": 10,
      "description": "Directory depth of the data-folder drive scan."
    },
    {
      "key": "discovery.maxDirs",
      "kind": "int",
      "default": 20000,
      "unit": "directories",
      "min": 100,
      "max": 1000000,
      "description": "Directory budget of the drive scan."
    },
    {
      "key": "discovery.timeBudgetMs",
      "kind": "int",
      "default": 20000,
      "unit": "ms",
      "min": 1000,
      "max": 600000,
      "description": "Time budget of the drive scan."
    },
    {
      "key": "sync.windowTargetMs",
      "kind": "int",
      "default": 2000,
      "unit": "ms",
      "min": 200,
      "max": 30000,
      "description": "Target duration of one Tally read window; sizes the date window."
    },
    {
      "key": "sync.msPerVoucherEstimate",
      "kind": "int",
      "default": 7,
      "unit": "ms",
      "min": 1,
      "max": 1000,
      "description": "Cost model used until real latency is measured (conservative; measured 3-7 ms per voucher)."
    },
    {
      "key": "adaptive.timeoutFactor",
      "kind": "int",
      "default": 3,
      "unit": "x p95",
      "min": 1,
      "max": 20,
      "description": "Request timeout as a multiple of the measured p95 latency, once enough samples exist."
    },
    {
      "key": "adaptive.minSamples",
      "kind": "int",
      "default": 20,
      "unit": "samples",
      "min": 5,
      "max": 10000,
      "description": "Latency samples needed before measured values replace the defaults."
    },
    {
      "key": "adaptive.timeoutFloorMs",
      "kind": "int",
      "default": 2000,
      "unit": "ms",
      "min": 200,
      "max": 60000,
      "description": "Lowest timeout the adaptive control may choose, whatever the latency."
    },
    {
      "key": "batch.start",
      "kind": "int",
      "default": 10,
      "unit": "vouchers",
      "min": 1,
      "max": 1000,
      "description": "Initial vouchers per import batch."
    },
    {
      "key": "batch.min",
      "kind": "int",
      "default": 1,
      "unit": "vouchers",
      "min": 1,
      "max": 1000,
      "description": "Smallest import batch the adaptive control may fall back to."
    },
    {
      "key": "batch.max",
      "kind": "int",
      "default": 200,
      "unit": "vouchers",
      "min": 1,
      "max": 5000,
      "description": "Largest import batch the adaptive control may grow to."
    },
    {
      "key": "batch.growBy",
      "kind": "int",
      "default": 5,
      "unit": "vouchers",
      "min": 1,
      "max": 500,
      "description": "Vouchers added to the batch after each fast, successful import (additive increase)."
    },
    {
      "key": "batch.shrinkPercent",
      "kind": "int",
      "default": 50,
      "unit": "%",
      "min": 10,
      "max": 90,
      "description": "Percentage of the batch kept after a slow or failed import (multiplicative decrease)."
    },
    {
      "key": "retry.transientScheduleSec",
      "kind": "string",
      "default": "5,15,45,120,300,900",
      "unit": "seconds",
      "description": "Comma-separated delays between attempts for transient failures; the last one repeats."
    },
    {
      "key": "retry.jitterPercent",
      "kind": "int",
      "default": 20,
      "unit": "%",
      "min": 0,
      "max": 100,
      "description": "Random spread applied to retry delays so many agents do not retry in step."
    }
  ]
}
