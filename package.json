{
  "name": "tally-sync-ts",
  "version": "2.3.1",
  "description": "TallyPrime and Tally ERP 9 sync engine for TypeScript: discovers the company's own ledgers, posts GST invoices idempotently with read-back verification, protects Tally from overload, and survives crashes. Part of the ShopControl solution.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "author": "GreenHacker420 (Harsh Hirawat)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreenHacker420/tally-sync-ts.git"
  },
  "homepage": "https://github.com/GreenHacker420/tally-sync-ts#readme",
  "bugs": {
    "url": "https://github.com/GreenHacker420/tally-sync-ts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test --test-skip-pattern=\"XML Parser - C# fixture samples\" \"tests/**/*.test.ts\"",
    "example": "node --import tsx examples/example.ts",
    "test:live": "node --import tsx --test tests/live/*.live.test.ts",
    "export:policy": "npm run build && node scripts/export-policy-registry.mjs"
  },
  "keywords": [
    "accounting",
    "api",
    "circuit-breaker",
    "connector",
    "erp",
    "gst",
    "idempotent",
    "india",
    "invoice",
    "job-queue",
    "shopcontrol",
    "sync",
    "synchronisation",
    "tally",
    "tallyprime",
    "typescript",
    "whatsapp-billing",
    "xml"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fakeTally.d.ts",
      "import": "./dist/testing/fakeTally.js"
    }
  }
}
