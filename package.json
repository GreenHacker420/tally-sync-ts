{
  "name": "tally-sync-ts",
  "version": "1.0.0",
  "description": "Typed TypeScript client for the Tally Prime and Tally ERP 9 XML/TDL API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "author": "GreenHacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreenHacker420/tally-sync-ts.git"
  },
  "homepage": "https://github.com/GreenHacker420/tally-sync-ts#readme",
  "bugs": {
    "url": "https://github.com/GreenHacker420/tally-sync-ts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test --test-skip-pattern=\"XML Parser - C# fixture samples\" tests/**/*.test.ts",
    "example": "node --import tsx examples/example.ts"
  },
  "keywords": [
    "tally",
    "tallyprime",
    "connector",
    "accounting",
    "xml",
    "api",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}